{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent p5 Auto Painter Scene Plan",
  "type": "object",
  "required": ["canvas", "seed", "renderer", "layers"],
  "properties": {
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string"
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "renderer": {
      "enum": ["p5", "p5-brush", "hybrid"]
    },
    "build": {
      "enum": ["p5", "standalone"]
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "zIndex", "elements"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "zIndex": {
            "type": "number"
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/element"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false
    },
    "text": {
      "type": "object",
      "required": ["content", "language", "font"],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "language": {
          "enum": ["zh-Hant", "zh-Hans", "en", "ja", "ko", "th"]
        },
        "font": {
          "type": "object",
          "properties": {
            "family": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              ]
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "weight": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 1000
                },
                {
                  "enum": ["normal", "bold", "lighter", "bolder"]
                }
              ]
            },
            "style": {
              "enum": ["normal", "italic", "oblique"]
            }
          },
          "required": ["family", "size"]
        },
        "align": {
          "enum": ["left", "center", "right"]
        },
        "verticalAlign": {
          "enum": ["top", "middle", "bottom"]
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "letterSpacing": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "renderMode": {
          "enum": ["p5-text", "text-outline", "mixed"]
        }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "drawStrategy"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "enum": ["shape", "text"]
        },
        "drawStrategy": {
          "enum": ["primitive", "polygon", "bezier", "spline", "freehand", "repeated-marks", "watercolor", "hatch", "mass", "text"]
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "allowCrop": {
          "type": "boolean"
        },
        "zIndex": {
          "type": "number"
        },
        "style": {
          "type": "object"
        },
        "geometry": {
          "type": "object"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "text"
                  }
                }
              },
              {
                "required": ["drawStrategy"],
                "properties": {
                  "drawStrategy": {
                    "const": "text"
                  }
                }
              },
              {
                "required": ["text"]
              }
            ]
          },
          "then": {
            "required": ["bbox", "text"],
            "properties": {
              "drawStrategy": {
                "const": "text"
              },
              "type": {
                "const": "text"
              }
            }
          }
        }
      ]
    }
  }
}
