{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent p5 Auto Painter Scene Analysis",
  "type": "object",
  "required": ["source", "composition", "palette", "elements"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["width", "height", "aspectRatio"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "aspectRatio": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "composition": {"type": "string"},
    "palette": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "bbox", "zIndex", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "bbox": {
            "type": "array",
            "prefixItems": [
              {"type": "number"}, {"type": "number"},
              {"type": "number", "exclusiveMinimum": 0},
              {"type": "number", "exclusiveMinimum": 0}
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "shape": {"type": "string"},
          "material": {"type": "string"},
          "zIndex": {"type": "number"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "allowCrop": {"type": "boolean"}
        }
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string"}}
  }
}
